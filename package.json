{
  "name": "bunbietbay-teakays-trips",
  "private": true,
  "version": "0.0.0",
  "description": "Travel planning app with itinerary, expenses, members, places, packing, and local desktop storage.",
  "author": "teakay1311",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:desktop": "concurrently -k \"npm run dev:desktop:renderer\" \"npm run dev:desktop:electron\"",
    "dev:desktop:renderer": "vite --port=3000 --host=127.0.0.1",
    "dev:desktop:electron": "wait-on tcp:3000 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:3000 electron .",
    "desktop": "cross-env VITE_USE_HASH_ROUTER=true electron .",
    "build": "vite build",
    "build:web": "vite build",
    "build:desktop:renderer": "cross-env VITE_BASE_PATH=./ VITE_USE_HASH_ROUTER=true vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "test": "tsx --test tests/**/*.test.ts",
    "test:smoke": "node tests/smoke.mjs",
    "lint": "tsc --noEmit",
    "pack:desktop": "npm run build:desktop:renderer && electron-builder --dir",
    "dist:desktop": "npm run build:desktop:renderer && electron-builder",
    "dist:mac": "npm run build:desktop:renderer && electron-builder --mac dmg",
    "dist:win": "npm run build:desktop:renderer && electron-builder --win nsis"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^1.29.0",
    "@supabase/supabase-js": "^2.103.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.14.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "playwright": "^1.59.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.2.0",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.teakay.bunbietbaytrips",
    "productName": "Bunbietbay Trips",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.travel",
      "target": [
        "dmg"
      ],
      "artifactName": "${productName}-${version}-mac.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true,
      "createDesktopShortcut": true,
      "shortcutName": "Bunbietbay Trips"
    }
  }
}
